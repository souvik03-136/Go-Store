# =============================================================================
# Go-Store — Environment Variable Reference
# =============================================================================
# Copy this file:   cp .env.example .env
# Then fill in all values marked *** REQUIRED ***.
# Variables marked [default: X] are optional — the app uses that value when
# the variable is absent or empty.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port the HTTP server listens on.
# [default: 8080]
SERVER_PORT=8080

# Runtime environment. Controls Gin mode and log verbosity.
# Allowed values: development | production
# In production mode Gin runs in ReleaseMode (no debug output).
# [default: development]
APP_ENV=development


# -----------------------------------------------------------------------------
# DATABASE
# Supports PostgreSQL 14+ (recommended) and MySQL 8+.
# All DB_* variables are assembled into a DSN inside config.DatabaseConfig.DSN()
# -----------------------------------------------------------------------------

# Database driver.
# Allowed values: postgres | mysql
# [default: postgres]
DB_DRIVER=postgres

# Hostname or IP of the database server.
# When running via Docker Compose use the service name, e.g. "postgres".
# [default: localhost]
DB_HOST=localhost

# Port the database listens on.
# PostgreSQL default: 5432  |  MySQL default: 3306
# [default: 5432]
DB_PORT=5432

# Name of the database / schema to connect to.
# [default: gostore]
DB_DATABASE=gostore

# Database login username.
# [default: postgres]
DB_USERNAME=postgres

# *** REQUIRED ***
# Database password. The app prints a warning on startup when this is empty,
# but does not exit — suitable for local dev with passwordless setups.
DB_PASSWORD=

# TLS/SSL mode for the database connection.
# PostgreSQL values: disable | require | verify-ca | verify-full
# MySQL: set to "disable" (TLS is controlled in the DSN separately).
# [default: disable]
DB_SSL_MODE=disable


# -----------------------------------------------------------------------------
# AUTHENTICATION — JWT
#
# How it works:
#   1. At login a 16-byte cryptographically-random salt is generated.
#   2. signing_key = SHA-256( JWT_SECRET_KEY + salt )
#   3. The JWT is signed with that derived key using HMAC-SHA256.
#   4. Both the token AND the salt are returned to the client.
#   5. Every subsequent request must send:
#        Authorization: Bearer <token>
#        X-Salt: <salt>
#
# Tokens expire after 24 hours.
# -----------------------------------------------------------------------------

# *** REQUIRED ***
# Base secret used to derive per-token HMAC signing keys.
# Generate a secure value:
#   openssl rand -hex 32
# Minimum recommended length: 32 characters. Rotate this periodically.
JWT_SECRET_KEY=


# -----------------------------------------------------------------------------
# CLOUD STORAGE
#
# Set STORAGE_PROVIDER to "s3" or "gcs", then fill in ONLY that provider's
# block. The other block's variables are ignored at runtime.
#
# Uploaded files are stored under the key: <owner_id>/<file_uuid><ext>
# -----------------------------------------------------------------------------

# Which cloud storage backend to use.
# Allowed values: s3 | gcs
# [default: s3]
STORAGE_PROVIDER=s3


# --- AWS S3 ------------------------------------------------------------------
# Used when STORAGE_PROVIDER=s3

# AWS region where the S3 bucket is located.
# [default: us-east-1]
AWS_REGION=us-east-1

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# Name of the S3 bucket. The bucket must already exist.
AWS_BUCKET_NAME=

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# IAM access key ID for a user/role with these minimum permissions:
#   s3:PutObject  s3:DeleteObject  s3:GetObject
AWS_ACCESS_KEY_ID=

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# IAM secret access key that pairs with AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=


# --- Google Cloud Storage ----------------------------------------------------
# Used when STORAGE_PROVIDER=gcs

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# GCP project ID that owns the bucket.
GOOGLE_CLOUD_PROJECT_ID=

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# Name of the GCS bucket. The bucket must already exist.
GOOGLE_CLOUD_BUCKET_NAME=

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# Absolute or relative path to the GCP service account JSON key file.
# The service account must have the Storage Object Admin role (or equivalent).
# Example: ./secrets/gcp-service-account.json
GOOGLE_CLOUD_CREDENTIALS_FILE=


# -----------------------------------------------------------------------------
# DOCKER COMPOSE EXTRAS
# These are consumed ONLY by docker-compose.yml, not by the Go application.
# -----------------------------------------------------------------------------

# Superuser password for the Postgres container spun up by Compose.
DB_ROOT_PASSWORD=changeme_root